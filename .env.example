# THE WORKSHOP — production example
NODE_ENV=production

# Local/VPS only. Railway supplies PORT automatically and the app binds 0.0.0.0 there.
HOST=127.0.0.1
PORT=8787

# Security / first-run behavior
WORKSHOP_DEV_AUTH=0
WORKSHOP_SEED_DEMO=0
WORKSHOP_PUBLIC_URL=https://workshop.example.com

# Persistent storage. On Railway, attaching a volume automatically supplies
# RAILWAY_VOLUME_MOUNT_PATH, so WORKSHOP_DATA_DIR can normally be omitted.
WORKSHOP_DATA_DIR=/var/lib/the-workshop
WORKSHOP_DB=/var/lib/the-workshop/workshop.db
WORKSHOP_BACKUP_DIR=/var/backups/the-workshop

# First production Owner. These are only used to create/promote the account
# when it does not already have a password. After first successful sign-in,
# remove these variables from the hosting platform.
WORKSHOP_BOOTSTRAP_OWNER_NAME=Mike
WORKSHOP_BOOTSTRAP_OWNER_EMAIL=you@example.com
WORKSHOP_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-long-random-password

# Transactional email (optional, but recommended for production requests and recovery)
# Supported providers: off, log, resend
WORKSHOP_EMAIL_PROVIDER=off
# RESEND_API_KEY=re_...
WORKSHOP_FROM_EMAIL=THE WORKSHOP <workshop@your-verified-domain.example>
# Optional. If omitted, the first active Owner email is used.
# WORKSHOP_ADMIN_EMAIL=mike@greenshoegarage.com

# Optional integrations
# GITHUB_TOKEN=

# Testing only; never use on a public production deployment.
# WORKSHOP_RATE_LIMIT=0

# One-time Owner recovery (leave disabled normally).
# Set to 1 plus a NEW random recovery ID for one deployment only.
WORKSHOP_OWNER_RECOVERY=0
WORKSHOP_OWNER_RECOVERY_ID=

# GearHead Crew membership provider bridge
WORKSHOP_MEMBERSHIP_PROVIDER=manual
WORKSHOP_GEARHEAD_JOIN_URL=
WORKSHOP_GEARHEAD_MANAGE_URL=
WORKSHOP_MEMBERSHIP_SYNC_SECRET=

# Stripe GearHead Crew billing
STRIPE_SECRET_KEY=
# Legacy single-price fallback (optional once both plan IDs are set)
STRIPE_GEARHEAD_PRICE_ID=
STRIPE_GEARHEAD_MONTHLY_PRICE_ID=
STRIPE_GEARHEAD_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
WORKSHOP_MAX_VIDEO_MB=750
